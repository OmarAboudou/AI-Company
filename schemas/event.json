{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/OmarAboudou/LLM-Company/main/schemas/event.json",
    "oneOf": [
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "message-sent" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "threadId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the thread, i.e. the name of its folder in .llmco/threads."
                },
                "messageId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the message, i.e. the name of its folder in the thread's messages. Recorded just before the message is written: an interrupted sending can leave it naming no message."
                },
                "mentions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens"
                    },
                    "description": "Ids of the positions the message mentions, as its message.json records them."
                }
            },
            "required": [
                "type",
                "occurredAt",
                "depth",
                "threadId",
                "messageId",
                "mentions"
            ],
            "additionalProperties": false,
            "description": "A message was added to a thread."
        },
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "task-created" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "taskId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the task, i.e. the name of its file in .llmco/tasks."
                }
            },
            "required": ["type", "occurredAt", "depth", "taskId"],
            "additionalProperties": false,
            "description": "A task was created for a position, and waits for whoever works it."
        },
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "task-started" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "taskId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the task, i.e. the name of its file in .llmco/tasks."
                }
            },
            "required": ["type", "occurredAt", "depth", "taskId"],
            "additionalProperties": false,
            "description": "Whoever works the task's position started it."
        },
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "task-completed" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "taskId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the task, i.e. the name of its file in .llmco/tasks."
                },
                "summary": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What was done, as whoever did it sums it up."
                }
            },
            "required": ["type", "occurredAt", "depth", "taskId", "summary"],
            "additionalProperties": false,
            "description": "The task was done."
        },
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "task-failed" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "taskId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the task, i.e. the name of its file in .llmco/tasks."
                },
                "reason": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Why the task was given up."
                }
            },
            "required": ["type", "occurredAt", "depth", "taskId", "reason"],
            "additionalProperties": false,
            "description": "The task was given up."
        },
        {
            "type": "object",
            "properties": {
                "type": { "type": "string", "const": "chain-stopped" },
                "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                    "description": "When it happened, in UTC."
                },
                "depth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "How many tasks led to it, each caused by the one before: 0 for what a person does. A task created from an event of depth d has depth d + 1, and so has what its run causes."
                },
                "causeEventId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens",
                    "description": "Id of the event the task would have been created for, i.e. the name of its file in .llmco/journal."
                },
                "stoppedTask": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens"
                        },
                        "positionId": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                            "patternErrorMessage": "must be kebab-case: lowercase letters and digits separated by single hyphens"
                        },
                        "params": {
                            "type": "object",
                            "propertyNames": { "type": "string" },
                            "additionalProperties": {}
                        }
                    },
                    "required": ["type", "positionId", "params"],
                    "additionalProperties": false,
                    "description": "The task the chain stopped before, as a listener asked for it: its type, the position it was for and its parameters."
                }
            },
            "required": [
                "type",
                "occurredAt",
                "depth",
                "causeEventId",
                "stoppedTask"
            ],
            "additionalProperties": false,
            "description": "llmco created no task for an event, whose chain of tasks had reached the company's maxTaskDepth."
        }
    ],
    "title": "llmco event",
    "description": "An event of the company's journal, in .llmco/journal/<event-id>.json, the id being the time it happened followed by a random suffix. Written by llmco and never modified: the journal keeps, in git, what happened in the company."
}
