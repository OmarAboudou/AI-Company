{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "plugins": ["./biome-plugins/require-async.grit"],
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "asNeeded"
        }
    },
    "linter": {
        "rules": {
            "preset": "recommended",
            "style": {
                "noExcessiveLinesPerFile": {
                    "level": "error",
                    "options": {
                        "maxLines": 300
                    }
                }
            },
            "suspicious": {
                "noImportCycles": "error"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/**", "!src/cli/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noProcessEnv": "error",
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "paths": {
                                    "commander": "Only src/cli/ imports commander: the core returns what a command prints, and throws a UserError to refuse.",
                                    "@commander-js/extra-typings": "Only src/cli/ imports commander: the core returns what a command prints, and throws a UserError to refuse."
                                },
                                "patterns": [
                                    {
                                        "group": ["**/cli/**"],
                                        "message": "Nothing outside src/cli/ imports from it: the core receives what it needs, such as the project's root, as parameters."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    ]
}
